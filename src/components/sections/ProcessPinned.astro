---
import { homeCopy } from '@/data/home';
import type { Lang } from '@/data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy(lang).process;

// Four layouts for the same 24 nodes: scattered data → network → packaged service → feedback loop.
let seed = 11;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const N = 24;
const s0 = Array.from({ length: N }, () => [60 + rnd() * 480, 50 + rnd() * 300]);
const layers = [6, 8, 6, 4];
const xsL = [110, 240, 370, 500];
const s1: number[][] = [];
layers.forEach((count, li) => { for (let k = 0; k < count; k++) s1.push([xsL[li], 200 + (k - (count - 1) / 2) * 42]); });
const s2 = Array.from({ length: N }, (_, i) => [245 + (i % 6) * 22, 160 + Math.floor(i / 6) * 26]);
const s3 = Array.from({ length: N }, (_, i) => { const a = (i / N) * Math.PI * 2 - Math.PI / 2; return [300 + Math.cos(a) * 130, 200 + Math.sin(a) * 130]; });
const edges: [number, number][] = [];
let off = 0;
for (let li = 0; li < layers.length - 1; li++) {
  const a0 = off, b0 = off + layers[li];
  for (let a = 0; a < layers[li]; a++) for (let b = 0; b < layers[li + 1]; b++) if ((a + b) % 2 === 0) edges.push([a0 + a, b0 + b]);
  off += layers[li];
}
const states = JSON.stringify([s0, s1, s2, s3]);
---

<section class="surface-dark relative" data-surface="dark" id="process">
  <div class="relative md:h-[420vh]" data-proc-wrap data-states={states}>
    <div class="md:sticky md:top-0 md:flex md:h-[100svh] md:items-center">
      <div class="container-x grid w-full gap-10 py-24 md:grid-cols-[0.9fr_1.1fr] md:items-center md:py-0">
        <div>
          <p class="eyebrow">{c.eyebrow}</p>
          <h2 class="h2 mt-5 max-w-xl">{c.title}</h2>
          <ol class="relative mt-10 grid gap-6 md:mt-12 md:block md:h-48" data-proc-chapters>
            {c.chapters.map((ch, i) => (
              <li class:list={['proc-ch md:absolute md:inset-x-0 md:top-0', i !== 0 && 'md:opacity-0']} data-proc-ch={i}>
                <p class="mono text-xs text-ember">0{i + 1} / 0{c.chapters.length}</p>
                <h3 class="mt-2 text-3xl font-medium tracking-tight md:text-5xl">{ch.t}</h3>
                <p class="mt-3 max-w-md text-ash">{ch.d}</p>
              </li>
            ))}
            <li class="proc-ch hidden md:absolute md:inset-x-0 md:top-0 md:block md:opacity-0" data-proc-ch={c.chapters.length}>
              <p class="mono text-xs text-mint">↻</p>
              <h3 class="serif-accent text-gradient mt-2 text-4xl md:text-6xl">{c.end}</h3>
            </li>
          </ol>
          <div class="mt-10 hidden h-px w-full max-w-md overflow-hidden bg-white/10 md:block"><div class="h-full origin-left scale-x-0 bg-gradient-to-r from-ember to-violet" data-proc-bar></div></div>
        </div>

        <div class="relative hidden aspect-[3/2] w-full md:block" aria-hidden="true">
          <div class="blob left-1/4 top-1/4 size-80 bg-ember/20"></div>
          <div class="blob right-0 top-0 size-72 bg-violet/25 [animation-delay:-9s]"></div>
          <svg viewBox="0 0 600 400" class="relative h-full w-full" data-proc-svg>
            <rect x="225" y="140" width="150" height="120" rx="18" fill="rgb(255 255 255 / 0.03)" stroke="#ff7a1a" stroke-opacity=".6" class="proc-box" opacity="0" />
            <g class="proc-arrows" opacity="0" stroke="#7ce3a1" stroke-width="1.4" fill="none">
              <path d="M375 170 H 470" /><path d="M375 200 H 500" /><path d="M375 230 H 470" />
              <circle cx="474" cy="170" r="3" fill="#7ce3a1" /><circle cx="504" cy="200" r="3" fill="#7ce3a1" /><circle cx="474" cy="230" r="3" fill="#7ce3a1" />
            </g>
            <g class="proc-edges" opacity="0">
              {edges.map(([a, b]) => (
                <line x1={s1[a][0]} y1={s1[a][1]} x2={s1[b][0]} y2={s1[b][1]} stroke="#ff9a5c" stroke-opacity=".22" stroke-width=".8" />
              ))}
            </g>
            <g class="proc-loop" opacity="0">
              <circle cx="300" cy="200" r="130" fill="none" stroke="#8b7cff" stroke-opacity=".35" stroke-dasharray="4 6" />
              <path d="M220 260 L 260 236 L 290 244 L 330 200 L 360 186 L 390 150" fill="none" stroke="#7ce3a1" stroke-width="2.2" stroke-linecap="round" />
            </g>
            <g data-proc-nodes>
              {s0.map(([x, y], i) => (
                <circle cx={x} cy={y} r={i % 5 === 0 ? 5 : 3.6} fill={i % 3 === 0 ? '#8b7cff' : '#ff9a5c'} />
              ))}
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, reducedMotion } from '@/scripts/motion';
  const wrap = document.querySelector<HTMLElement>('[data-proc-wrap]');
  if (wrap && window.matchMedia('(min-width: 768px)').matches && !reducedMotion()) {
    const states: number[][][] = JSON.parse(wrap.dataset.states ?? '[]');
    const nodes = [...wrap.querySelectorAll<SVGCircleElement>('[data-proc-nodes] circle')];
    const chapters = [...wrap.querySelectorAll<HTMLElement>('[data-proc-ch]')];
    const toState = (k: number) => nodes.map((n, i) => ({ el: n, cx: states[k][i][0], cy: states[k][i][1] }));
    const tl = gsap.timeline({
      defaults: { ease: 'power2.inOut' },
      scrollTrigger: { trigger: wrap, start: 'top top', end: 'bottom bottom', scrub: 0.8 },
    });
    const move = (k: number, at: number) => toState(k).forEach(({ el, cx, cy }, i) => tl.to(el, { attr: { cx, cy }, duration: 1 }, at + i * 0.012));
    const chapter = (k: number, at: number) => {
      tl.to(chapters, { opacity: 0, y: -16, duration: 0.25 }, at);
      tl.fromTo(chapters[k], { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.35 }, at + 0.2);
    };
    tl.to(nodes, { attr: { r: (i: number) => (i % 5 === 0 ? 6 : 4) }, duration: 0.6 }, 0);
    move(1, 0.8); chapter(1, 0.8);
    tl.to('.proc-edges', { opacity: 1, duration: 0.6 }, 1.5);
    move(2, 2.4); chapter(2, 2.4);
    tl.to('.proc-edges', { opacity: 0, duration: 0.4 }, 2.4).to('.proc-box', { opacity: 1, duration: 0.5 }, 3).to('.proc-arrows', { opacity: 1, duration: 0.5 }, 3.2);
    move(3, 4.1); chapter(3, 4.1);
    tl.to(['.proc-box', '.proc-arrows'], { opacity: 0, duration: 0.4 }, 4.1).to('.proc-loop', { opacity: 1, duration: 0.6 }, 4.7);
    tl.to('[data-proc-svg]', { rotate: 0, duration: 0.6 }, 5.4);
    chapter(4, 5.6);
    tl.to('[data-proc-bar]', { scaleX: 1, duration: 6.3, ease: 'none' }, 0);
  }
</script>
