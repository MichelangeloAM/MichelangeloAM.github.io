---
import { getImage } from 'astro:assets';
import { homeCopy } from '@/data/home';
import { route } from '@/data/routes.mjs';
import { img } from '@/lib/images';
import AgentWidget from './AgentWidget.astro';
import type { Lang } from '@/data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy(lang).hero;

const desk = img('hero-core-desktop');
const mob = img('hero-core-mobile');
const deskAvif = desk && (await getImage({ src: desk, format: 'avif', widths: [960, 1440, 1800], width: 1800 }));
const deskWebp = desk && (await getImage({ src: desk, format: 'webp', widths: [960, 1440, 1800], width: 1800 }));
const mobAvif = mob && (await getImage({ src: mob, format: 'avif', widths: [600, 900], width: 900 }));
const mobWebp = mob && (await getImage({ src: mob, format: 'webp', widths: [600, 900], width: 900 }));
const fallback = desk && (await getImage({ src: desk, format: 'jpg', width: 1440 }));
---

<section class="surface-dark relative isolate flex min-h-[100svh] flex-col overflow-hidden pt-28 md:pt-32" data-surface="dark" data-hero>
  <!-- Key visual -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    {fallback && (
      <picture>
        {mobAvif && <source media="(max-width: 767px)" type="image/avif" srcset={mobAvif.srcSet.attribute} sizes="100vw" />}
        {mobWebp && <source media="(max-width: 767px)" type="image/webp" srcset={mobWebp.srcSet.attribute} sizes="100vw" />}
        {deskAvif && <source type="image/avif" srcset={deskAvif.srcSet.attribute} sizes="(min-width: 768px) 80vw, 100vw" />}
        {deskWebp && <source type="image/webp" srcset={deskWebp.srcSet.attribute} sizes="(min-width: 768px) 80vw, 100vw" />}
        <img
          src={fallback.src}
          alt=""
          width={fallback.attributes.width}
          height={fallback.attributes.height}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-visual absolute inset-0 h-full w-full object-cover object-[70%_50%] md:left-auto md:right-0 md:w-[78%] md:object-right"
          data-hero-visual
        />
      </picture>
    )}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_45%,transparent_0%,rgb(10_10_11/0.35)_45%,#0a0a0b_80%)]"></div>
    <div class="absolute inset-y-0 left-0 hidden w-[55%] bg-gradient-to-r from-ink via-ink/90 to-transparent md:block"></div>
    <div class="absolute inset-x-0 top-0 h-[55%] bg-gradient-to-b from-ink via-ink/70 to-transparent md:hidden"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent"></div>
    <div class="blob left-[-10%] top-[10%] size-[38rem] bg-ember/30"></div>
    <div class="blob bottom-[-20%] right-[10%] size-[34rem] bg-violet/30 [animation-delay:-8s]"></div>
  </div>

  <div class="container-x flex flex-1 flex-col justify-center pb-10">
    <div class="max-w-[64rem]">
      <p class="eyebrow" data-hero-in>{c.eyebrow}</p>
      <h1 class="display mt-6" data-hero-title>
        <span class="block text-bone/95" data-split>{c.lead}</span>
        <span class="relative mt-1 block h-[1.02em] overflow-hidden" data-rotator>
          <span class="serif-accent text-gradient block pr-2 text-[1.08em] leading-[0.95]" data-rot-word>{c.words[0]}</span>
          {c.words.slice(1).map((w) => (
            <span class="serif-accent text-gradient absolute inset-x-0 top-0 block pr-2 text-[1.08em] leading-[0.95] opacity-0" aria-hidden="true" data-rot-word>{w}</span>
          ))}
        </span>
      </h1>
      <p class="lede mt-7" data-hero-in>{c.sub}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3" data-hero-in>
        <a href={route('contact', lang)} class="btn btn-ember" data-magnetic>{c.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
        <a href={route('work', lang)} class="btn btn-ghost">{c.ctaSecondary}</a>
      </div>
      <p class="mono mt-8 inline-flex items-center gap-2.5 text-xs text-ash" data-hero-in>
        <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-mint/70"></span><span class="relative inline-flex size-2 rounded-full bg-mint"></span></span>
        {c.status}
      </p>
    </div>
  </div>

  <div class="container-x relative pb-14 md:absolute md:bottom-10 md:right-0 md:w-auto md:pb-0">
    <AgentWidget lang={lang} />
  </div>
</section>

<script>
  import { gsap, reducedMotion } from '@/scripts/motion';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !reducedMotion()) {
    document.fonts.ready.then(() => {
      const target = hero.querySelector('[data-split]');
      const split = target ? new SplitText(target, { type: 'words', wordsClass: 'inline-block will-change-transform', aria: 'none' }) : null;
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      if (split) tl.from(split.words, { yPercent: 40, rotate: 3, duration: 1.1, stagger: 0.05 });
      tl.from('[data-rot-word]:first-child', { yPercent: 60, duration: 1.1 }, '-=0.9')
        .from('[data-hero-in]', { y: 18, duration: 1, stagger: 0.06 }, '-=0.9')
        .from('[data-agent]', { y: 40, opacity: 0, scale: 0.97, duration: 1.3 }, '-=0.9')
        .from('[data-hero-visual]', { scale: 1.1, duration: 2.2, ease: 'power2.out' }, 0);
    });

    // Rotating final word.
    const words = [...hero.querySelectorAll<HTMLElement>('[data-rot-word]')];
    let i = 0;
    if (words.length > 1) {
      setInterval(() => {
        const cur = words[i];
        i = (i + 1) % words.length;
        const next = words[i];
        gsap.to(cur, { yPercent: -110, opacity: 0, duration: 0.8, ease: 'expo.inOut' });
        gsap.fromTo(next, { yPercent: 110, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.8, ease: 'expo.inOut' });
      }, 2600);
    }

    // Parallax on the key visual.
    gsap.to('[data-hero-visual]', {
      yPercent: 12,
      scale: 1.05,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });
  }
</script>
