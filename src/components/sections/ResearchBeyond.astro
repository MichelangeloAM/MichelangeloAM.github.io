---
import { Image } from 'astro:assets';
import { homeCopy } from '@/data/home';
import { img, photo } from '@/lib/images';
import { route } from '@/data/routes.mjs';
import { profile } from '@/data/profile';
import { t } from '@/i18n/ui';
import type { Lang } from '@/data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy(lang);
const s = t(lang);
const lab = img('research-lab');
const photos = [photo(1), photo(2), photo(3)];
---

<section class="surface-dark relative" data-surface="dark" id="research">
  <div class="container-x section-y !pt-0">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="reveal relative overflow-hidden rounded-[2rem] border border-white/10">
        {lab ? <Image src={lab} alt="" widths={[640, 1024]} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover" loading="lazy" /> : <div class="aspect-[4/3] bg-[radial-gradient(circle_at_40%_40%,rgb(139_124_255/0.35),transparent_60%)]"></div>}
      </div>
      <div>
        <p class="eyebrow reveal">{c.research.eyebrow}</p>
        <h2 class="h2 reveal mt-5">{c.research.title}</h2>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2" data-reveal-group>
          {c.research.items.map((it) => (
            <li class="reveal card p-5">
              <p class="mono text-[0.66rem] uppercase tracking-[0.12em] text-ember">{it.k}</p>
              <p class="mt-2 text-sm leading-relaxed text-bone/85">{it.d}</p>
            </li>
          ))}
        </ul>
        <a href={route('research', lang)} class="btn btn-ghost reveal mt-8">{s.cta.learnMore} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<div class="fade-to-light" aria-hidden="true"></div>
<section class="surface-light relative overflow-hidden" data-surface="light" id="beyond">
  <div class="container-x section-y">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="eyebrow reveal">{c.beyond.eyebrow}</p>
        <h2 class="h2 reveal mt-5">{c.beyond.title}</h2>
      </div>
      <p class="lede reveal md:max-w-md md:text-base">{c.beyond.sub}</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-12" data-reveal-group>
      {profile.apps.map((app, i) => (
        <a href={app.url} target="_blank" rel="noopener" class:list={['reveal card spotlight group flex flex-col justify-between !bg-white p-6 md:col-span-3', i === 0 ? 'md:row-span-1' : '']}>
          <div>
            <p class="mono text-[0.66rem] uppercase tracking-[0.12em] text-smoke">iOS · App Store</p>
            <h3 class="mt-2 text-2xl font-medium tracking-tight">{app.name}</h3>
            <p class="serif-accent mt-1 text-lg text-[#9c3d07]">{app.tagline[lang]}</p>
            <p class="mt-3 text-sm text-smoke">{app.desc[lang]}</p>
          </div>
          <span class="mt-6 text-sm font-medium">App Store <span class="inline-block transition-transform group-hover:translate-x-1">↗</span></span>
        </a>
      ))}
      <figure class="reveal relative overflow-hidden rounded-[1.4rem] md:col-span-6 md:row-span-2">
        {photos[0] && <Image src={photos[0]} alt={c.beyond.photoAlt[0]} widths={[640, 1200, 1800]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full min-h-72 w-full object-cover" loading="lazy" />}
        <figcaption class="mono absolute bottom-3 left-3 rounded-full bg-ink/70 px-3 py-1 text-[0.65rem] text-bone backdrop-blur">© Michelangelo Amoruso Manzari · Ancona</figcaption>
      </figure>
      <figure class="reveal relative overflow-hidden rounded-[1.4rem] md:col-span-3">
        {photos[1] && <Image src={photos[1]} alt={c.beyond.photoAlt[1]} widths={[480, 800]} sizes="(min-width: 768px) 25vw, 100vw" class="aspect-[4/5] w-full object-cover" loading="lazy" />}
      </figure>
      <figure class="reveal relative overflow-hidden rounded-[1.4rem] md:col-span-3">
        {photos[2] && <Image src={photos[2]} alt={c.beyond.photoAlt[2]} widths={[480, 800]} sizes="(min-width: 768px) 25vw, 100vw" class="aspect-[4/5] w-full object-cover" loading="lazy" />}
      </figure>
      <div class="reveal flex flex-wrap items-center gap-3 md:col-span-12">
        <a href={profile.links.unsplash} target="_blank" rel="me noopener" class="chip !text-ink hover:!border-ink">{c.beyond.photos} ↗</a>
        <span class="chip !text-ink">{c.beyond.running}</span>
      </div>
    </div>
  </div>
</section>
