---
import { homeCopy } from '@/data/home';
import { caseUrl } from '@/data/routes.mjs';
import { t } from '@/i18n/ui';
import type { Lang } from '@/data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy(lang).tree;
const s = t(lang);
const n = c.branches.length;
const xs = c.branches.map((_, i) => 100 + (i * 800) / (n - 1));
---

<section class="surface-light relative overflow-hidden" data-surface="light">
  <div class="container-x section-y">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="eyebrow reveal">{c.eyebrow}</p>
        <h2 class="h2 reveal mt-5 max-w-3xl">{c.title}</h2>
      </div>
      <p class="lede reveal md:max-w-sm md:text-base">{c.sub}</p>
    </div>

    <div class="relative mt-14" data-tree>
      <svg viewBox="0 0 1000 200" class="hidden w-full md:block" aria-hidden="true">
        {xs.map((x) => (
          <path d={`M500 40 C 500 110, ${x} 90, ${x} 170`} fill="none" stroke="#0a0a0b" stroke-opacity=".18" stroke-width="1.4" pathLength="1" class="tree-line" />
        ))}
      </svg>
      <div class="absolute left-1/2 top-0 hidden -translate-x-1/2 -translate-y-1/2 md:block">
        <div class="rounded-2xl bg-ink px-6 py-4 text-center text-bone shadow-[0_20px_50px_-20px_rgb(10_10_11/0.6)]">
          <p class="mono text-[0.62rem] uppercase tracking-[0.14em] text-ash">KPI</p>
          <p class="mt-1 text-xl font-medium tracking-tight">{c.root}</p>
        </div>
      </div>
      <p class="mb-4 rounded-2xl bg-ink px-5 py-4 text-bone md:hidden"><span class="mono block text-[0.62rem] uppercase tracking-[0.14em] text-ash">KPI</span><span class="text-xl font-medium">{c.root}</span></p>

      <ul class="grid gap-3 md:-mt-3 md:grid-cols-5" data-reveal-group>
        {c.branches.map((b, i) => (
          <li class="reveal">
            <button
              type="button"
              class="tree-node card spotlight w-full !rounded-2xl p-4 text-left transition-all"
              data-tree-node={i}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`tree-detail-${i}`}
            >
              <span class="mono text-[0.62rem] uppercase tracking-[0.12em] text-smoke">Driver 0{i + 1}</span>
              <span class="mt-1 block text-lg font-medium leading-tight tracking-tight">{b.k}</span>
              <span class="mono mt-3 inline-flex items-center gap-1.5 rounded-full bg-ember/12 px-2 py-1 text-[0.66rem] text-[#9c3d07]">◆ {b.lever}</span>
            </button>
            <div id={`tree-detail-${i}`} class:list={['tree-detail mt-2 text-sm', i !== 0 && 'hidden']}>
              <a href={caseUrl(b.caseKey as any, lang)} class="inline-flex items-center gap-1 text-smoke underline decoration-ember underline-offset-4 hover:text-ink">{s.cta.readCase} →</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .tree-node[aria-expanded='true'] { background: #fff; border-color: rgb(255 122 26 / 0.5); box-shadow: 0 18px 40px -22px rgb(255 122 26 / 0.7); transform: translateY(-4px); }
</style>

<script>
  import { gsap, reducedMotion } from '@/scripts/motion';
  const root = document.querySelector<HTMLElement>('[data-tree]');
  if (root) {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('[data-tree-node]')];
    const details = [...root.querySelectorAll<HTMLElement>('.tree-detail')];
    const lines = [...root.querySelectorAll<SVGPathElement>('.tree-line')];
    nodes.forEach((node, i) => node.addEventListener('click', () => {
      nodes.forEach((nd, k) => nd.setAttribute('aria-expanded', String(k === i)));
      details.forEach((d, k) => d.classList.toggle('hidden', k !== i));
      lines.forEach((l, k) => { l.setAttribute('stroke', k === i ? '#ff7a1a' : '#0a0a0b'); l.setAttribute('stroke-opacity', k === i ? '0.9' : '0.18'); });
    }));
    lines[0]?.setAttribute('stroke', '#ff7a1a');
    lines[0]?.setAttribute('stroke-opacity', '0.9');
    if (!reducedMotion()) {
      gsap.fromTo(lines, { attr: { 'stroke-dasharray': 1, 'stroke-dashoffset': 1 } }, {
        attr: { 'stroke-dashoffset': 0 }, duration: 1.4, stagger: 0.1, ease: 'expo.out',
        scrollTrigger: { trigger: root, start: 'top 75%', once: true },
      });
    }
  }
</script>
