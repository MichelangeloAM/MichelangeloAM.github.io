---
// Animated product-style UI mocks (Mixpanel-like) for each capability.
// Pure HTML/SVG: crisp at any size, cheap to animate, and readable by crawlers.
import type { Lang } from '@/data/profile';
interface Props { kind: string; lang: Lang }
const { kind, lang } = Astro.props;
const it = lang === 'it';
---

<div class="mock relative w-full min-w-0 max-w-full overflow-hidden rounded-[1.4rem] border border-black/10 bg-white text-ink shadow-[0_30px_80px_-30px_rgb(10_10_11/0.35)]" data-mock={kind}>
  <div class="flex items-center gap-1.5 border-b border-black/5 bg-paper/60 px-4 py-2.5">
    <span class="size-2.5 rounded-full bg-[#ff5f57]"></span><span class="size-2.5 rounded-full bg-[#febc2e]"></span><span class="size-2.5 rounded-full bg-[#28c840]"></span>
    <span class="mono ml-3 truncate text-[0.68rem] text-smoke">
      {kind === 'agents' && 'agent://claims-assistant/run/4821'}
      {kind === 'llm' && 'inbox://claims@company · auto-triage'}
      {kind === 'ml' && 'model://claim-cost-gbm · v3'}
      {kind === 'forecasting' && 'forecast://site-load · 15-min'}
      {kind === 'vision' && 'vision://line-2 · detector'}
      {kind === 'research' && 'lab://experiments · benchmark'}
    </span>
  </div>

  <div class="p-5">
    {kind === 'agents' && (
      <ol class="mono grid gap-2 text-[0.72rem]">
        {[
          ['plan', it ? 'Scomponi: leggi sinistro → stima costo → verifica polizza' : 'Decompose: read claim → estimate cost → check policy', 'violet'],
          ['tool', 'extract_fields(claim_4821.pdf) → 23 fields', 'ember'],
          ['tool', 'predict_cost(model="gbm-v3") → €2,180 ± 9%', 'ember'],
          ['tool', 'check_policy(id="AU-77…") → coverage ok', 'ember'],
          ['guard', it ? 'importo < soglia → nessuna approvazione richiesta' : 'amount < threshold → no approval needed', 'mint'],
          ['done', it ? 'Bozza di liquidazione pronta per il liquidatore' : 'Settlement draft ready for adjuster', 'mint'],
        ].map(([tag, text, tone]) => (
          <li class="mock-row flex min-w-0 items-start gap-2.5 rounded-xl border border-black/5 bg-paper/50 px-3 py-2">
            <span class:list={['shrink-0 rounded-md px-1.5 py-0.5 text-[0.62rem] uppercase', tone === 'violet' && 'bg-violet/15 text-[#5b4bd6]', tone === 'ember' && 'bg-ember/15 text-[#9c3d07]', tone === 'mint' && 'bg-mint/25 text-[#1f7a46]']}>{tag}</span>
            <span class="min-w-0 break-words text-ink/80">{text}</span>
          </li>
        ))}
      </ol>
    )}

    {kind === 'llm' && (
      <ul class="grid gap-2.5">
        {[
          [it ? 'Richiesta perizia – sinistro RCA 2026/118' : 'Appraisal request – motor claim 2026/118', it ? 'Perizia' : 'Appraisal', '#8b7cff', it ? 'Il cliente chiede l’invio del perito entro venerdì; allegate 6 foto.' : 'Customer asks for an appraiser by Friday; 6 photos attached.'],
          [it ? 'Contestazione importo liquidato' : 'Dispute on settled amount', it ? 'Reclamo' : 'Complaint', '#ff7a1a', it ? 'Ritiene sottostimato il danno al paraurti; chiede revisione.' : 'Believes bumper damage was under-estimated; asks for review.'],
          [it ? 'Invio documenti mancanti' : 'Missing documents sent', it ? 'Documenti' : 'Documents', '#7ce3a1', it ? 'CID firmato e libretto; pratica completabile.' : 'Signed accident form and registration; file can be completed.'],
        ].map(([subj, cat, color, sum]) => (
          <li class="mock-row min-w-0 overflow-hidden rounded-2xl border border-black/5 bg-paper/50 p-3">
            <div class="flex items-center justify-between gap-3">
              <span class="min-w-0 truncate text-sm font-medium">{subj}</span>
              <span class="mono shrink-0 rounded-full px-2 py-0.5 text-[0.62rem] text-ink" style={`background:${color}33`}>{cat}</span>
            </div>
            <p class="mt-1.5 text-[0.8rem] leading-snug text-smoke"><span class="mono text-[0.62rem] text-ember">AI ▸ </span>{sum}</p>
          </li>
        ))}
      </ul>
    )}

    {kind === 'ml' && (
      <div class="grid gap-4">
        <div>
          <p class="mono text-[0.65rem] uppercase tracking-[0.12em] text-smoke">{it ? 'Importanza delle feature' : 'Feature importance'}</p>
          <ul class="mt-2 grid gap-1.5">
            {[[it ? 'Zona del danno' : 'Damage area', 92], [it ? 'Valore del veicolo' : 'Vehicle value', 74], [it ? 'Tipo di urto' : 'Impact type', 61], [it ? 'Parti sostituite' : 'Parts replaced', 48], [it ? 'Regione officina' : 'Repair region', 31]].map(([k, v]) => (
              <li class="grid grid-cols-[7.5rem_1fr] items-center gap-3 text-[0.75rem]">
                <span class="truncate text-ink/80">{k}</span>
                <span class="h-2 overflow-hidden rounded-full bg-black/5"><span class="mock-bar block h-full rounded-full bg-gradient-to-r from-ember to-violet" style={`--w:${v}%; width:${v}%`}></span></span>
              </li>
            ))}
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-2xl bg-ink p-3 text-bone">
            <p class="mono text-[0.6rem] uppercase tracking-[0.12em] text-ash">{it ? 'Costo stimato' : 'Predicted cost'}</p>
            <p class="mt-1 text-2xl font-medium tracking-tight">€2,180</p>
            <p class="mono text-[0.62rem] text-mint">± 9% · p90</p>
          </div>
          <div class="rounded-2xl border border-black/5 bg-paper/60 p-3">
            <p class="mono text-[0.6rem] uppercase tracking-[0.12em] text-smoke">{it ? 'Rischio frode' : 'Fraud risk'}</p>
            <svg viewBox="0 0 100 34" class="mt-1 h-10 w-full" aria-hidden="true">
              <polyline points="0,26 10,24 20,27 30,23 40,25 50,22 60,24 70,8 80,23 90,25 100,24" fill="none" stroke="#0a0a0b" stroke-opacity=".5" stroke-width="1.2" />
              <circle cx="70" cy="8" r="3.2" fill="#ff7a1a" class="animate-[var(--animate-pulse-soft)]" />
            </svg>
            <p class="mono text-[0.62rem] text-[#9c3d07]">{it ? '1 anomalia segnalata' : '1 anomaly flagged'}</p>
          </div>
        </div>
      </div>
    )}

    {kind === 'forecasting' && (
      <div>
        <div class="flex items-center justify-between">
          <p class="mono text-[0.65rem] uppercase tracking-[0.12em] text-smoke">{it ? 'Consumo · prossimi 7 giorni' : 'Consumption · next 7 days'}</p>
          <p class="mono rounded-full bg-mint/25 px-2 py-0.5 text-[0.62rem] text-[#1f7a46]">MAPE 4.1%</p>
        </div>
        <svg viewBox="0 0 320 170" class="mt-3 w-full" aria-hidden="true">
          {[30, 70, 110, 150].map((y) => <line x1="0" x2="320" y1={y} y2={y} stroke="#0a0a0b" stroke-opacity=".06" />)}
          <path d="M190 70 C 215 40, 235 62, 255 52 S 295 30, 320 44 L 320 96 C 295 86, 275 110, 255 104 S 215 112, 190 98 Z" fill="#8b7cff" fill-opacity=".18" />
          <path class="mock-draw" d="M0 120 C 20 90, 35 112, 55 100 S 90 70, 110 92 S 150 112, 170 84 S 185 70, 190 84" fill="none" stroke="#0a0a0b" stroke-width="2" pathLength="1" />
          <path class="mock-draw" d="M190 84 C 215 56, 235 86, 255 78 S 295 60, 320 70" fill="none" stroke="#ff7a1a" stroke-width="2.4" stroke-dasharray="5 4" />
          <line x1="190" x2="190" y1="10" y2="160" stroke="#0a0a0b" stroke-opacity=".25" stroke-dasharray="2 3" />
          <text x="194" y="20" font-size="9" fill="#5e5b55" font-family="monospace">{it ? 'oggi' : 'today'}</text>
        </svg>
        <div class="mono mt-2 flex gap-4 text-[0.62rem] text-smoke">
          <span class="flex items-center gap-1.5"><i class="h-0.5 w-4 bg-ink"></i>{it ? 'reale' : 'actual'}</span>
          <span class="flex items-center gap-1.5"><i class="h-0.5 w-4 bg-ember"></i>{it ? 'previsione' : 'forecast'}</span>
          <span class="flex items-center gap-1.5"><i class="h-2 w-4 rounded-sm bg-violet/25"></i>{it ? 'intervallo 80%' : '80% interval'}</span>
        </div>
      </div>
    )}

    {kind === 'vision' && (
      <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-[#1b1b20]">
        <div class="absolute inset-0 bg-[repeating-linear-gradient(90deg,#1b1b20_0_38px,#222228_38px_40px)] animate-[belt_6s_linear_infinite]"></div>
        {[
          ['16%', '22%', '22%', '34%', it ? 'Bottiglia PET' : 'PET bottle', '0.97', '#8b7cff'],
          ['48%', '14%', '16%', '26%', it ? 'Tappo PP' : 'PP cap', '0.91', '#ff7a1a'],
          ['44%', '52%', '26%', '34%', it ? 'Vaschetta PS' : 'PS tray', '0.88', '#7ce3a1'],
          ['76%', '30%', '17%', '40%', 'HDPE', '0.94', '#ff9ec4'],
        ].map(([l, t, w, h, label, conf, color]) => (
          <div class="mock-box absolute rounded-md border-2" style={`left:${l};top:${t};width:${w};height:${h};border-color:${color}`}>
            <span class="mono absolute -top-5 left-0 whitespace-nowrap rounded px-1 text-[0.58rem] text-ink" style={`background:${color}`}>{label} · {conf}</span>
            <span class="absolute inset-[18%] rounded-[40%] bg-white/15"></span>
          </div>
        ))}
        <div class="absolute inset-x-0 top-0 h-full w-[3px] bg-ember shadow-[0_0_18px_4px_rgb(255_122_26/0.6)] animate-[scan_3.2s_ease-in-out_infinite]"></div>
      </div>
    )}

    {kind === 'research' && (
      <table class="mono w-full text-[0.7rem]">
        <thead>
          <tr class="text-left text-smoke"><th class="pb-2 font-normal">run</th><th class="pb-2 font-normal">model</th><th class="pb-2 text-right font-normal">F1</th><th class="pb-2 text-right font-normal">latency</th></tr>
        </thead>
        <tbody>
          {[['#12', 'baseline · logistic', '0.71', '2 ms', false], ['#18', 'xgboost · tuned', '0.84', '4 ms', false], ['#21', 'lightgbm · +text emb.', '0.88', '6 ms', true], ['#24', 'deep net · ensemble', '0.89', '41 ms', false]].map(([run, m, f1, lat, best]) => (
            <tr class:list={['mock-row border-t border-black/5', best && 'bg-ember/10']}>
              <td class="py-2 text-smoke">{run}</td>
              <td class="py-2">{m} {best && <span class="ml-1 rounded bg-ember px-1 text-[0.55rem] text-ink">{it ? 'scelto' : 'chosen'}</span>}</td>
              <td class="py-2 text-right">{f1}</td>
              <td class="py-2 text-right text-smoke">{lat}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-[0.75rem] leading-snug text-smoke">{it ? 'Si sceglie il miglior compromesso tra accuratezza, costo e latenza, non il punteggio più alto.' : 'Pick the best trade-off between accuracy, cost and latency, not just the top score.'}</p>
    )}
  </div>
</div>

<style>
  @keyframes belt { from { background-position: 0 0; } to { background-position: 80px 0; } }
  @keyframes scan { 0%, 100% { left: 4%; } 50% { left: 94%; } }
</style>
