---
import { Image } from 'astro:assets';
import { homeCopy } from '@/data/home';
import { img } from '@/lib/images';
import { t } from '@/i18n/ui';
import type { Lang } from '@/data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy(lang).lab;
const s = t(lang);
const belt = img('case-recycling-topdown');
// Approximate item positions on the generated top-down belt image (percent of width/height).
const items: { k: keyof typeof c.vision.classes; x: number; y: number; w: number; h: number; conf: number; color: string }[] = [
  { k: 'pet', x: 3.6, y: 30.5, w: 10.6, h: 37.2, conf: 0.97, color: '#8b7cff' },
  { k: 'hdpe', x: 16.3, y: 31.3, w: 13.6, h: 35.5, conf: 0.95, color: '#ff9ec4' },
  { k: 'cap', x: 32.3, y: 46.6, w: 6.4, h: 10, conf: 0.91, color: '#ff7a1a' },
  { k: 'tray', x: 40.4, y: 36.5, w: 15, h: 28.8, conf: 0.89, color: '#7ce3a1' },
  { k: 'cup', x: 57.1, y: 42.5, w: 11.6, h: 17.8, conf: 0.92, color: '#ffb27a' },
  { k: 'film', x: 69.9, y: 36, w: 13.9, h: 30.6, conf: 0.84, color: '#b7adff' },
  { k: 'box', x: 85.9, y: 41, w: 11.9, h: 20, conf: 0.93, color: '#5ec8ff' },
];
---

<section class="surface-light relative" data-surface="light" id="ml-lab">
  <div class="container-x section-y !pt-8">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="eyebrow reveal">{c.eyebrow}</p>
        <h2 class="h2 reveal mt-5 max-w-3xl">{c.title}</h2>
      </div>
      <p class="lede reveal md:max-w-sm md:text-base">{c.sub}</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-2" data-reveal-group>
      <!-- Fraud threshold -->
      <article class="reveal card !bg-white p-6 md:p-7" data-fraud>
        <header class="flex items-start justify-between gap-4">
          <div>
            <h3 class="h3">{c.fraud.title}</h3>
            <p class="mt-2 max-w-md text-sm text-smoke">{c.fraud.desc}</p>
          </div>
          <span class="chip shrink-0">{s.labels.synthetic}</span>
        </header>
        <div class="mt-6">
          <svg viewBox="0 0 400 120" class="w-full" aria-hidden="true" data-fraud-plot>
            <rect x="0" y="0" width="400" height="120" fill="transparent" />
            <g data-fraud-points></g>
            <line x1="200" x2="200" y1="0" y2="120" stroke="#ff7a1a" stroke-width="2" data-fraud-line />
          </svg>
          <label class="mt-4 flex items-center gap-4 text-sm">
            <span class="mono shrink-0 text-[0.7rem] text-smoke">{c.fraud.threshold}</span>
            <input type="range" min="0.05" max="0.95" step="0.01" value="0.5" class="lab-range w-full" data-fraud-range aria-label={c.fraud.threshold} />
            <output class="mono w-10 text-right text-sm" data-fraud-out>0.50</output>
          </label>
          <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl bg-paper p-3"><dt class="mono text-[0.6rem] uppercase tracking-[0.1em] text-smoke">{c.fraud.precision}</dt><dd class="mt-1 text-2xl font-medium tracking-tight" data-fraud-p>–</dd></div>
            <div class="rounded-2xl bg-paper p-3"><dt class="mono text-[0.6rem] uppercase tracking-[0.1em] text-smoke">{c.fraud.recall}</dt><dd class="mt-1 text-2xl font-medium tracking-tight" data-fraud-r>–</dd></div>
            <div class="rounded-2xl bg-paper p-3"><dt class="mono text-[0.6rem] uppercase tracking-[0.1em] text-smoke">{c.fraud.caught}</dt><dd class="mt-1 text-2xl font-medium tracking-tight text-[#1f7a46]" data-fraud-c>–</dd></div>
            <div class="rounded-2xl bg-paper p-3"><dt class="mono text-[0.6rem] uppercase tracking-[0.1em] text-smoke">{c.fraud.alarms}</dt><dd class="mt-1 text-2xl font-medium tracking-tight text-[#9c3d07]" data-fraud-f>–</dd></div>
          </dl>
        </div>
      </article>

      <!-- Forecast builder -->
      <article class="reveal card !bg-white p-6 md:p-7" data-forecast>
        <header class="flex items-start justify-between gap-4">
          <div>
            <h3 class="h3">{c.forecast.title}</h3>
            <p class="mt-2 max-w-md text-sm text-smoke">{c.forecast.desc}</p>
          </div>
          <span class="chip shrink-0">{s.labels.synthetic}</span>
        </header>
        <svg viewBox="0 0 400 150" class="mt-6 w-full" aria-hidden="true">
          {[30, 60, 90, 120].map((y) => <line x1="0" x2="400" y1={y} y2={y} stroke="#0a0a0b" stroke-opacity=".06" />)}
          <path d="" fill="#8b7cff" fill-opacity=".16" data-fc-band />
          <path d="" fill="none" stroke="#0a0a0b" stroke-width="1.8" data-fc-actual />
          <path d="" fill="none" stroke="#ff7a1a" stroke-width="2.4" stroke-linecap="round" data-fc-pred />
        </svg>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {c.forecast.features.map((f, i) => (
            <button type="button" class="fc-toggle chip !py-1.5 !text-[0.72rem] transition-colors" aria-pressed="false" data-fc-feature={i}>+ {f}</button>
          ))}
          <span class="ml-auto text-right">
            <span class="mono block text-[0.6rem] uppercase tracking-[0.1em] text-smoke">{c.forecast.error}</span>
            <span class="text-2xl font-medium tracking-tight" data-fc-err>–</span>
          </span>
        </div>
        <div class="mono mt-3 flex gap-4 text-[0.62rem] text-smoke">
          <span class="flex items-center gap-1.5"><i class="h-0.5 w-4 bg-ink"></i>{c.forecast.actual}</span>
          <span class="flex items-center gap-1.5"><i class="h-0.5 w-4 bg-ember"></i>{c.forecast.predicted}</span>
        </div>
      </article>

      <!-- Vision inspector -->
      <article class="reveal card !bg-white p-6 md:p-7 lg:col-span-2" data-vision>
        <header class="flex items-start justify-between gap-4">
          <div>
            <h3 class="h3">{c.vision.title}</h3>
            <p class="mt-2 max-w-xl text-sm text-smoke">{c.vision.desc}</p>
          </div>
          <span class="chip shrink-0">{s.labels.synthetic}</span>
        </header>
        <div class="vision-stage group relative mt-6 aspect-[4/3] overflow-hidden rounded-2xl bg-[#18181c] sm:aspect-[21/9]" data-vision-stage>
          <div class="absolute inset-x-0 top-1/2 aspect-[3/2] -translate-y-1/2 max-sm:inset-x-auto max-sm:left-1/2 max-sm:h-full max-sm:w-auto max-sm:-translate-x-1/2" data-vision-frame>
            {belt && <Image src={belt} alt="" widths={[640, 1024, 1536]} sizes="(min-width: 1024px) 80vw, 140vw" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />}
            {items.map((it) => (
              <div class="vision-box pointer-events-none absolute rounded-lg border-2 opacity-0 transition-all duration-300" style={`left:${it.x}%;top:${it.y}%;width:${it.w}%;height:${it.h}%;border-color:${it.color};box-shadow:0 0 24px ${it.color}55`} data-x={it.x + it.w / 2}>
                <span class="mono absolute -top-6 left-0 whitespace-nowrap rounded-md px-1.5 py-0.5 text-[0.62rem] font-medium text-ink" style={`background:${it.color}`}>{c.vision.classes[it.k]} · {it.conf.toFixed(2)}</span>
              </div>
            ))}
            <div class="vision-scan pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-transparent via-ember/35 to-transparent mix-blend-screen"></div>
          </div>
          <p class="mono absolute bottom-3 left-3 rounded-full bg-ink/70 px-3 py-1 text-[0.65rem] text-bone backdrop-blur transition-opacity group-hover:opacity-0">{c.vision.hint} ↔</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .lab-range { appearance: none; height: 4px; border-radius: 999px; background: linear-gradient(90deg, #ff7a1a var(--p, 50%), rgb(10 10 11 / 0.12) var(--p, 50%)); }
  .lab-range::-webkit-slider-thumb { appearance: none; width: 22px; height: 22px; border-radius: 999px; background: #0a0a0b; border: 4px solid #fff; box-shadow: 0 2px 10px rgb(0 0 0 / 0.3); cursor: grab; }
  .lab-range::-moz-range-thumb { width: 18px; height: 18px; border-radius: 999px; background: #0a0a0b; border: 4px solid #fff; cursor: grab; }
  .fc-toggle[aria-pressed='true'] { background: #0a0a0b; color: #f6f4ef; border-color: #0a0a0b; }
  .vision-box.is-on { opacity: 1; transform: scale(1); }
  .vision-box { transform: scale(0.92); }
</style>

<script>
  // ---------- Synthetic data, deterministic ----------
  const rng = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);

  // Fraud: 160 cases with a model score; 12% are fraud, scores overlap.
  const fraudRoot = document.querySelector<HTMLElement>('[data-fraud]');
  if (fraudRoot) {
    const r = rng(7);
    const gauss = () => { let u = 0, v = 0; while (!u) u = r(); while (!v) v = r(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };
    const cases = Array.from({ length: 160 }, (_, i) => {
      const fraud = i % 8 === 0 || i % 37 === 0;
      const score = Math.min(0.99, Math.max(0.01, fraud ? 0.72 + gauss() * 0.14 : 0.3 + gauss() * 0.15));
      const amount = Math.round(800 + r() * 9000);
      return { fraud, score, amount, y: 10 + r() * 100 };
    });
    const g = fraudRoot.querySelector('[data-fraud-points]')!;
    const ns = 'http://www.w3.org/2000/svg';
    const dots = cases.map((c) => {
      const el = document.createElementNS(ns, 'circle');
      el.setAttribute('cx', String(c.score * 400));
      el.setAttribute('cy', String(c.y));
      el.setAttribute('r', c.fraud ? '4' : '3');
      g.appendChild(el);
      return el;
    });
    const range = fraudRoot.querySelector<HTMLInputElement>('[data-fraud-range]')!;
    const out = fraudRoot.querySelector('[data-fraud-out]')!;
    const line = fraudRoot.querySelector('[data-fraud-line]')!;
    const P = fraudRoot.querySelector('[data-fraud-p]')!, R = fraudRoot.querySelector('[data-fraud-r]')!, C = fraudRoot.querySelector('[data-fraud-c]')!, F = fraudRoot.querySelector('[data-fraud-f]')!;
    const totalFraud = cases.filter((c) => c.fraud).reduce((s, c) => s + c.amount, 0);
    const fmt = new Intl.NumberFormat(document.documentElement.lang, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0, notation: 'compact' });
    const update = () => {
      const th = Number(range.value);
      let tp = 0, fp = 0, fn = 0, caught = 0;
      cases.forEach((c, i) => {
        const flagged = c.score >= th;
        if (flagged && c.fraud) { tp++; caught += c.amount; }
        if (flagged && !c.fraud) fp++;
        if (!flagged && c.fraud) fn++;
        const d = dots[i];
        d.setAttribute('fill', c.fraud ? '#ff7a1a' : '#0a0a0b');
        d.setAttribute('fill-opacity', flagged ? (c.fraud ? '1' : '0.55') : '0.14');
        d.setAttribute('stroke', flagged && !c.fraud ? '#9c3d07' : 'none');
      });
      const prec = tp + fp ? tp / (tp + fp) : 1;
      const rec = tp + fn ? tp / (tp + fn) : 0;
      out.textContent = th.toFixed(2);
      line.setAttribute('x1', String(th * 400)); line.setAttribute('x2', String(th * 400));
      range.style.setProperty('--p', `${((th - 0.05) / 0.9) * 100}%`);
      P.textContent = `${Math.round(prec * 100)}%`;
      R.textContent = `${Math.round(rec * 100)}%`;
      C.textContent = `${fmt.format(caught)} / ${fmt.format(totalFraud)}`;
      F.textContent = String(fp);
    };
    range.addEventListener('input', update);
    update();
  }

  // Forecast: 60 points; each feature removes a component of the error.
  const fcRoot = document.querySelector<HTMLElement>('[data-forecast]');
  if (fcRoot) {
    const r = rng(42);
    const N = 60;
    const season = (i: number) => Math.sin((i / N) * Math.PI * 4) * 22;
    const weather = Array.from({ length: N }, () => (r() - 0.5) * 26);
    const holiday = (i: number) => (i % 14 === 6 || i % 14 === 7 ? -18 : 0);
    const noise = Array.from({ length: N }, () => (r() - 0.5) * 6);
    const base = 75;
    const actual = Array.from({ length: N }, (_, i) => base + season(i) + weather[i] * 0.6 + holiday(i) + noise[i]);
    const on = [false, false, false];
    const x = (i: number) => (i / (N - 1)) * 400;
    const y = (v: number) => 150 - ((v - 20) / 110) * 150;
    const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
    const actEl = fcRoot.querySelector('[data-fc-actual]')!;
    const predEl = fcRoot.querySelector('[data-fc-pred]')!;
    const bandEl = fcRoot.querySelector('[data-fc-band]')!;
    const errEl = fcRoot.querySelector('[data-fc-err]')!;
    actEl.setAttribute('d', path(actual));
    let shown: number[] | null = null;
    const render = () => {
      const pred = actual.map((_, i) => base + (on[0] ? season(i) : 0) + (on[1] ? weather[i] * 0.6 : 0) + (on[2] ? holiday(i) : 0));
      const mape = actual.reduce((s, a, i) => s + Math.abs((a - pred[i]) / a), 0) / N;
      const width = 6 + mape * 160;
      const from = shown ?? pred.map(() => base);
      const start = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - start) / 600);
        const e = 1 - Math.pow(1 - k, 3);
        const cur = pred.map((p, i) => from[i] + (p - from[i]) * e);
        predEl.setAttribute('d', path(cur));
        const up = cur.map((v) => v + width), dn = cur.map((v) => v - width).reverse();
        bandEl.setAttribute('d', `${path(up)} ${dn.map((v, i) => `L${x(N - 1 - i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ')} Z`);
        if (k < 1) requestAnimationFrame(step); else shown = pred;
      };
      requestAnimationFrame(step);
      errEl.textContent = `${(mape * 100).toFixed(1)}%`;
    };
    fcRoot.querySelectorAll<HTMLButtonElement>('[data-fc-feature]').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.fcFeature);
      on[i] = !on[i];
      b.setAttribute('aria-pressed', String(on[i]));
      render();
    }));
    render();
  }

  // Vision: reveal detections near the pointer, or sweep automatically.
  const stage = document.querySelector<HTMLElement>('[data-vision-stage]');
  if (stage) {
    const boxes = [...stage.querySelectorAll<HTMLElement>('.vision-box')];
    const scan = stage.querySelector<HTMLElement>('.vision-scan')!;
    const frame = stage.querySelector<HTMLElement>('[data-vision-frame]')!;
    let auto = true;
    const reveal = (pct: number) => {
      scan.style.left = `${pct}%`;
      scan.style.transform = 'translateX(-50%)';
      boxes.forEach((b) => b.classList.toggle('is-on', Number(b.dataset.x) <= pct + 6));
    };
    stage.addEventListener('pointermove', (e) => {
      auto = false;
      const r = frame.getBoundingClientRect();
      reveal(((e.clientX - r.left) / r.width) * 100);
    });
    stage.addEventListener('pointerleave', () => { auto = true; });
    let p = 0;
    const io = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;
      const tick = () => {
        if (auto) { p = (p + 0.35) % 112; reveal(p - 6); }
        if (stage.isConnected) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      io.disconnect();
    }, { threshold: 0.3 });
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) io.observe(stage);
    else boxes.forEach((b) => b.classList.add('is-on'));
  }
</script>
