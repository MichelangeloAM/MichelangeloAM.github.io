---
import { SITE_URL, profile } from '@/data/profile';
import { alternatesFor } from '@/data/routes.mjs';
import { htmlLang, ogLocale } from '@/i18n/ui';
import type { Lang } from '@/data/profile';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  ogImage?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonld?: unknown;
  published?: string;
  modified?: string;
}

const { title, description, lang, path, ogImage, type = 'website', noindex = false, jsonld, published, modified } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const alt = alternatesFor(path);
const og = new URL(ogImage ?? `/og/default-${lang}.jpg`, SITE_URL).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alt && (
  <>
    <link rel="alternate" hreflang="en" href={new URL(alt.en, SITE_URL).href} />
    <link rel="alternate" hreflang="it-IT" href={new URL(alt.it, SITE_URL).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.en, SITE_URL).href} />
  </>
)}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={profile.name} />
<meta name="creator" content={profile.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={`${profile.name} · AI & ML Engineer`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={ogLocale(lang)} />
<meta property="og:locale:alternate" content={lang === 'it' ? 'en_US' : 'it_IT'} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
{type === 'profile' && <meta property="profile:first_name" content={profile.givenName} />}
{type === 'profile' && <meta property="profile:last_name" content={profile.familyName} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />

<meta name="geo.region" content="IT-RM" />
<meta name="geo.placename" content="Rome" />
<meta http-equiv="content-language" content={htmlLang(lang)} />

{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
