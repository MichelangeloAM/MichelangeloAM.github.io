---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { route } from '@/data/routes.mjs';
import { t } from '@/i18n/ui';
import type { Lang } from '@/data/profile';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  accent?: string;
  lede?: string;
  crumbs: { name: string; url?: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}
const { lang, eyebrow, title, accent, lede, crumbs, image, imageAlt = '' } = Astro.props;
const s = t(lang);
const trail = [{ name: s.labels.breadcrumbHome, url: route('home', lang) }, ...crumbs];
---

<section class="surface-dark relative isolate overflow-hidden pt-32 md:pt-40" data-surface="dark">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    {image && <Image src={image} alt="" widths={[960, 1600]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="eager" fetchpriority="high" />}
    <div class="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/75 to-ink"></div>
    <div class="blob -left-20 top-0 size-[30rem] bg-ember/25"></div>
    <div class="blob right-0 top-10 size-[26rem] bg-violet/25 [animation-delay:-7s]"></div>
  </div>
  <div class="container-x pb-16 md:pb-24">
    <nav aria-label="Breadcrumb">
      <ol class="mono flex flex-wrap items-center gap-2 text-[0.7rem] text-ash">
        {trail.map((c, i) => (
          <li class="flex items-center gap-2">
            {c.url && i < trail.length - 1 ? <a href={c.url} class="hover:text-bone">{c.name}</a> : <span aria-current="page" class="text-bone/80">{c.name}</span>}
            {i < trail.length - 1 && <span aria-hidden="true">/</span>}
          </li>
        ))}
      </ol>
    </nav>
    <p class="eyebrow mt-10">{eyebrow}</p>
    <h1 class="mt-5 max-w-5xl text-[clamp(2.4rem,6vw,5.6rem)] font-medium leading-[0.98] tracking-[-0.045em]">
      {title}{accent && <> <span class="serif-accent text-gradient">{accent}</span></>}
    </h1>
    {lede && <p class="lede mt-7 max-w-2xl">{lede}</p>}
    <slot />
  </div>
  {image && imageAlt && <span class="sr-only">{imageAlt}</span>}
</section>
